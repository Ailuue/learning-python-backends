          },
          {
            "method": "GET",
            "path": "/advanced/schema-info",
            "label": "Info about the hidden endpoint",
            "fields": []
          }
        ],
        "externalLinks": [
          {
            "label": "OpenAPI JSON (find x-internal-note)",
            "href": "http://localhost:8001/openapi.json"
