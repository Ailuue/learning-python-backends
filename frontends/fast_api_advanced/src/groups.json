    "topics": [
      {
        "id": "advanced-middleware",
        "number": "16",
        "title": "Advanced Middleware",
        "description": "Add middleware with @app.middleware(\"http\") for full request/response control. Or mount ASGI middleware directly. This app uses middleware to inject X-Process-Time into every response.",
