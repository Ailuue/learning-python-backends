        "id": "sub-applications",
        "number": "17",
        "title": "Sub Applications - Mounts",
        "description": "Mount a separate FastAPI app at a path prefix using app.mount(). Each sub-app has its own OpenAPI schema and /docs. Useful for versioning (v1, v2) or plugin architecture.",
        "docPath": "/advanced/sub-applications/",
        "endpoints": [
          {
            "method": "GET",
            "path": "/advanced/sub-applications/info",
