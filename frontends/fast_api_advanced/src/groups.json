  {
    "id": "deps-security",
    "label": "Dependencies & Security",
    "topics": [
      {
        "id": "advanced-dependencies",
        "number": "10",
        "title": "Advanced Dependencies",
        "description": "Create parameterized dependencies by making a class with __call__. The class instance acts as the dependency, letting you configure behavior at the point of use.",
        "docPath": "/advanced/advanced-dependencies/",
        "endpoints": [
          {
            "method": "GET",
            "path": "/advanced/deps/short",
            "label": "QueryChecker(min_length=3)",
            "fields": [
              {
                "name": "q",
                "in": "query",
                "type": "text",
                "placeholder": "hi (too short) or hello"
              }
            ]
          },
          {
            "method": "GET",
            "path": "/advanced/deps/long",
            "label": "QueryChecker(min_length=10)",
            "fields": [
              {
                "name": "q",
                "in": "query",
                "type": "text",
                "placeholder": "short vs longenough"
              }
            ]
          }
        ]
      },
      {
        "id": "http-basic-auth",
        "number": "13",
        "title": "HTTP Basic Auth",
        "description": "Use HTTPBasic security scheme with Depends(). The browser sends credentials as Base64 in the Authorization header. Always use secrets.compare_digest() to prevent timing attacks.",
        "docPath": "/advanced/security/http-basic-auth/",
        "endpoints": [
          {
            "method": "GET",
            "path": "/advanced/basic-auth",
            "label": "Basic Auth (admin / password123)",
            "fields": [
              {
                "name": "authorization",
                "in": "header",
                "type": "text",
                "placeholder": "Basic YWRtaW46cGFzc3dvcmQxMjM="
              }
            ],
            "note": "Send Authorization: Basic <base64(admin:password123)>. The value above is pre-encoded."
          }
        ]
      }
    ]
  },
  {
    "id": "request-data",
    "label": "Request & Data",
    "topics": [
      {
        "id": "request-directly",
        "number": "14",
        "title": "Using the Request Directly",
        "description": "Accept a Request parameter to access the raw request — URL, headers, query params, client IP, body bytes. Useful when you need data that FastAPI doesn't expose through typed params.",
        "docPath": "/advanced/using-request-directly/",
        "endpoints": [
          {
            "method": "GET",
            "path": "/advanced/request-info",
            "label": "Inspect request metadata",
            "fields": []
          },
          {
            "method": "POST",
            "path": "/advanced/request-body-bytes",
            "label": "Read raw body bytes",
            "fields": [
              {
                "name": "body",
                "in": "body",
                "type": "json",
                "placeholder": "{\"raw\": \"anything here\"}"
              }
            ]
          }
        ]
      },
      {
        "id": "dataclasses",
        "number": "15",
        "title": "Using Dataclasses",
        "description": "Use Python @dataclass instead of Pydantic BaseModel for request/response bodies. FastAPI converts them to JSON schemas automatically. Useful when you already have dataclasses in your codebase.",
        "docPath": "/advanced/dataclasses/",
        "endpoints": [
          {
            "method": "POST",
            "path": "/advanced/dataclasses/item",
            "label": "Create item using @dataclass",
            "fields": [
              {
                "name": "body",
                "in": "body",
                "type": "json",
                "placeholder": "{\n  \"name\": \"Widget\",\n  \"price\": 9.99,\n  \"tags\": [\"cool\"]\n}"
              }
            ]
          },
          {
            "method": "GET",
            "path": "/advanced/dataclasses/items",
            "label": "List items (response type is list[DataclassItem])",
            "fields": []
          }
        ]
      },
      {
        "id": "base64-bytes",
        "number": "32",
        "title": "JSON with Bytes as Base64",
        "description": "Pydantic models with bytes fields are automatically encoded as Base64 strings in JSON. This lets you send/receive binary data through a standard JSON API.",
        "docPath": "/advanced/json-base64-bytes/",
        "endpoints": [
          {
            "method": "POST",
            "path": "/advanced/base64/encode",
            "label": "Send bytes, get Base64 back",
            "fields": [
              {
                "name": "body",
                "in": "body",
                "type": "json",
                "placeholder": "{\n  \"name\": \"my-file\",\n  \"data\": \"SGVsbG8gV29ybGQ=\"\n}"
              }
            ],
            "note": "\"data\" must be a Base64-encoded string. \"SGVsbG8gV29ybGQ=\" = \"Hello World\""
          },
          {
            "method": "POST",
            "path": "/advanced/base64/round-trip",
            "label": "See how FastAPI encodes bytes in JSON",
            "fields": [
              {
                "name": "body",
                "in": "body",
                "type": "json",
                "placeholder": "{\n  \"name\": \"test\",\n  \"data\": \"SGVsbG8gV29ybGQ=\"\n}"
              }
            ]
          }
        ]
      },
      {
        "id": "python-types",
        "number": "31",
        "title": "Advanced Python Types",
        "description": "Use Generic models (e.g. Paginated[T]) for typed, reusable response wrappers. FastAPI and Pydantic support Python's full type system including TypeVar and Generic.",
        "docPath": "/advanced/advanced-python-types/",
        "endpoints": [
          {
            "method": "GET",
            "path": "/advanced/python-types/paginated",
            "label": "Generic Paginated[Item] response",
            "fields": [
              {
                "name": "page",
                "in": "query",
                "type": "text",
                "placeholder": "1"
              },
              {
                "name": "page_size",
                "in": "query",
                "type": "text",
                "placeholder": "3"
              }
            ]
          }
        ]
      }
    ]
  },
