[
  {
    "id": "responses",
    "label": "Responses",
    "topics": [
      {
        "id": "stream-data",
        "number": "01",
        "title": "Stream Data",
        "description": "Return a StreamingResponse with an async generator. FastAPI streams each yielded chunk as it's produced — ideal for large files, SSE, and real-time data.",
        "docPath": "/advanced/stream-data/",
        "endpoints": [
          {
            "method": "GET",
            "path": "/stream/text",
            "label": "Stream plain text chunks",
            "fields": [],
            "streaming": true
          },
          {
            "method": "GET",
            "path": "/stream/sse",
            "label": "Stream SSE events",
            "fields": [],
            "streaming": true
          }
        ]
      },
      {
        "id": "response-directly",
        "number": "04",
        "title": "Return a Response Directly",
        "description": "Return a Response subclass (JSONResponse, HTMLResponse, etc.) directly instead of a dict. Useful when you need control over headers, status, or content-type that FastAPI wouldn't set automatically.",
        "docPath": "/advanced/response-directly/",
        "endpoints": [
          {
            "method": "GET",
            "path": "/advanced/response-directly/json",
            "label": "JSONResponse with custom header",
            "fields": []
          },
          {
            "method": "GET",
            "path": "/advanced/response-directly/xml",
            "label": "Raw XML response",
            "fields": []
          }
        ]
      },
      {
        "id": "custom-response",
        "number": "05",
        "title": "Custom Response",
        "description": "Use response_class= on the decorator to change the default response type. HTMLResponse, PlainTextResponse, RedirectResponse, FileResponse — each sets the appropriate Content-Type.",
        "docPath": "/advanced/custom-response/",
        "endpoints": [
          {
            "method": "GET",
            "path": "/advanced/custom/html",
            "label": "HTMLResponse",
            "fields": []
          },
          {
            "method": "GET",
            "path": "/advanced/custom/text",
            "label": "PlainTextResponse",
            "fields": []
          },
          {
            "method": "GET",
            "path": "/advanced/custom/redirect",
            "label": "RedirectResponse → /advanced/custom/text",
            "fields": []
          }
        ]
      },
      {
        "id": "additional-responses",
        "number": "06",
        "title": "Additional Responses in OpenAPI",
        "description": "Document multiple possible response shapes using responses={} on the decorator. FastAPI adds them to the OpenAPI schema so clients know what to expect for each status code.",
        "docPath": "/advanced/additional-responses/",
        "endpoints": [
          {
            "method": "GET",
            "path": "/advanced/items/{item_id}",
            "label": "Returns ItemOut (200) or ErrorOut (404)",
            "fields": [
              {
                "name": "item_id",
                "in": "path",
                "type": "text",
                "placeholder": "item-1 or missing-id",
                "required": true
              }
            ]
          }
        ],
        "externalLinks": [
          {
            "label": "OpenAPI schema (see responses)",
            "href": "http://localhost:8001/openapi.json"
          }
        ]
      },
      {
        "id": "response-cookies",
        "number": "07",
        "title": "Response Cookies",
        "description": "Set and delete cookies by accepting a Response parameter and calling response.set_cookie() / response.delete_cookie(). The Response object is injected by FastAPI without affecting your return value.",
        "docPath": "/advanced/response-cookies/",
        "endpoints": [
          {
            "method": "POST",
            "path": "/advanced/cookies/set",
            "label": "Set session_token cookie",
            "fields": [
              {
                "name": "value",
                "in": "query",
                "type": "text",
                "placeholder": "my-session-value"
              }
            ]
          },
          {
            "method": "GET",
            "path": "/advanced/cookies/read",
            "label": "Read session_token cookie",
            "fields": [],
            "note": "Set the cookie first, then read it. Browser must be on same origin as the backend."
          },
          {
            "method": "POST",
            "path": "/advanced/cookies/delete",
            "label": "Delete session_token cookie",
            "fields": []
          }
        ]
      },
      {
        "id": "response-headers",
        "number": "08",
        "title": "Response Headers",
        "description": "Add custom headers to responses using the injected Response parameter or by returning a Response object with headers={}. Custom headers appear in the response visible to clients.",
        "docPath": "/advanced/response-headers/",
        "endpoints": [
          {
            "method": "GET",
            "path": "/advanced/headers/custom",
            "label": "X-Custom-Header + X-Request-Id",
            "fields": []
          },
          {
            "method": "GET",
            "path": "/advanced/headers/from-response-object",
            "label": "Headers via JSONResponse(headers={})",
            "fields": []
          }
        ]
      },
      {
        "id": "response-change-status",
        "number": "09",
        "title": "Response - Change Status Code",
        "description": "Dynamically override the status code at runtime by accepting a Response parameter and setting response.status_code. The decorator's status_code becomes the documented default.",
        "docPath": "/advanced/response-change-status-code/",
        "endpoints": [
          {
            "method": "GET",
            "path": "/advanced/status/dynamic",
            "label": "Dynamic 200 or 404 based on query param",
            "fields": [
              {
                "name": "found",
                "in": "query",
                "type": "select",
                "options": [
                  "true",
                  "false"
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "additional-status-codes",
        "number": "03",
        "title": "Additional Status Codes",
        "description": "Return different status codes depending on logic by combining response_model with JSONResponse or by injecting the Response object. Useful for 200 vs 201 on upsert endpoints.",
        "docPath": "/advanced/additional-status-codes/",
        "endpoints": [
          {
            "method": "PUT",
            "path": "/advanced/items/{item_id}",
            "label": "200 if exists, 201 if created (try \"item-1\" vs \"new-item\")",
            "fields": [
              {
                "name": "item_id",
                "in": "path",
                "type": "text",
                "placeholder": "item-1",
                "required": true
              },
              {
                "name": "name",
                "in": "query",
                "type": "text",
                "placeholder": "Widget"
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "path-ops",
