          }
        ]
      },
      {
        "id": "lifespan",
        "number": "21",
        "title": "Lifespan Events",
        "description": "Use the lifespan async context manager to run startup/shutdown logic. Code before yield runs on startup; code after yield on shutdown. Replaces the older @app.on_event() approach.",
        "docPath": "/advanced/events/",
        "endpoints": [
          {
            "method": "GET",
            "path": "/advanced/lifespan/log",
            "label": "View startup log",
            "fields": []
          }
        ]
      },
      {
        "id": "behind-proxy",
        "number": "18",
        "title": "Behind a Proxy",
        "description": "When behind a reverse proxy (nginx, Traefik), set root_path so FastAPI generates correct OpenAPI URLs. Pass it via --root-path CLI flag or as a constructor argument.",
        "docPath": "/advanced/behind-a-proxy/",
        "endpoints": [
          {
            "method": "GET",
            "path": "/advanced/proxy/info",
            "label": "Proxy & root_path info",
            "fields": []
          }
        ]
      },
      {
        "id": "settings",
        "number": "26",
        "title": "Settings and Environment Variables",
        "description": "Use pydantic-settings BaseSettings to load config from environment variables. Fields are matched to env vars (with optional prefix). Great for 12-factor app config.",
        "docPath": "/advanced/settings/",
        "endpoints": [
          {
            "method": "GET",
            "path": "/advanced/settings",
            "label": "Current app settings",
            "fields": []
          }
        ],
        "note": "Override with env vars: ADV_APP_NAME=\"My App\" ADV_DEBUG=true uvicorn ..."
      }
    ]
  },
