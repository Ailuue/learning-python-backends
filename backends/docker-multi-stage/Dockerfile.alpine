# =============================================================================
# ALPINE-BASED MULTI-STAGE — smallest base image, notable trade-offs
#
# Alpine Linux uses musl libc instead of glibc (which Debian uses). This
# matters because most Python binary wheels are compiled against glibc
# (the manylinux standard). On Alpine, pip cannot use those pre-built wheels
# and must compile packages from source — which requires gcc, musl-dev, etc.
#
# The irony: to get a smaller image, you often install a compiler, making the
# builder stage LARGER. The runtime stage is still small, but build times
# increase significantly for packages with C extensions.
#
# Packages that are painful on Alpine:
#   psycopg2       — needs pg_config, gcc
#   cryptography   — needs Rust (!)
#   numpy/pandas   — large build from source
#   Pillow         — needs libjpeg, zlib headers
#
# Our FastAPI app sidesteps this by using uvicorn WITHOUT [standard] extras.
# uvicorn[standard] pulls in httptools (Cython) and uvloop (Cython), which
# need compiling. Plain uvicorn is pure Python — no build tools needed.
# Trade-off: slightly lower request throughput without uvloop/httptools.
#
# Rule of thumb: use slim for apps with any C-extension deps; alpine only
# for apps that are provably pure-Python all the way down.
#
# Build:   docker build -f Dockerfile.alpine -t fastapi-alpine .
# Compare: docker images | grep fastapi
# =============================================================================


FROM python:3.12-alpine AS builder

WORKDIR /build

# apk is Alpine's package manager (equivalent to apt on Debian)
# --no-cache: don't store the apk package index on disk (saves ~8MB per layer)
# gcc + musl-dev: C compiler toolchain, needed if any dep compiles extensions
# Without them, pip install fails on C-extension packages with "gcc not found"
RUN apk add --no-cache gcc musl-dev

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY app/requirements.alpine.txt .
RUN pip install --no-cache-dir -r requirements.alpine.txt


FROM python:3.12-alpine

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /app
COPY app/ .

EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
