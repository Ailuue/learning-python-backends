# Copy to .env and fill in your real values.
# DATABASE_URL format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:password@localhost:5432/bookmark_manager

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

LOG_LEVEL=INFO
ENVIRONMENT=development

# Redis (for rate limiting + JWT blocklist)
REDIS_URL=redis://localhost:6379/0
# slowapi storage backend — must be a URI supported by the `limits` library
RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# Celery (background tasks)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
