# =============================================================================
# SINGLE-STAGE, SLIM BASE — intermediate option between full and multi-stage
#
# Switching the base image from python:3.12 → python:3.12-slim alone drops
# ~700MB without any structural change to the Dockerfile. It's the simplest
# optimization and often the right first step.
#
# python:3.12-slim is Debian with everything stripped out except the Python
# runtime. No gcc, no build tools, no apt package lists.
#
# Limitation: if any package needs to compile C extensions at install time
# (e.g. psycopg2, cryptography without binary wheels), pip will fail because
# the compiler isn't there. The fix is either:
#   a) use binary-wheel packages (psycopg2-binary, cryptography[hazmat])
#   b) apt-get install gcc + clean up in the same RUN command
#   c) use multi-stage (from Dockerfile) so the compiler stays in the builder
#
# Build:   docker build -f Dockerfile.slim -t fastapi-slim .
# Compare: docker images | grep fastapi
# =============================================================================

FROM python:3.12-slim

WORKDIR /app

COPY app/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
# Example to show that adding and removing on the same line will keep the image size down, 
# because the intermediate big file won't be committed to the layer. 
# If we did it in two separate RUN commands, the big file would be part of 
# the first layer and would still take up space in the final image even 
# after we delete it in the second layer.
RUN dd if=/dev/urandom of=/tmp/big bs=1M count=50 && rm /tmp/big
COPY app/ .

EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
