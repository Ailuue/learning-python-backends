# Only needed if your Postgres differs from the default below.
# The shared database-concepts/docker-compose.yml runs the pgvector/pgvector
# image and provisions this database with the vector extension enabled, using
# user 'postgres' / password 'postgres'. database.py already defaults to this URL.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/pgvector_demo
