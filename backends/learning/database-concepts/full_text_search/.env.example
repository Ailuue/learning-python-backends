# Only needed if your Postgres differs from the defaults below.
# The shared database-concepts/docker-compose.yml provisions this database with
# user 'postgres' / password 'postgres', and db.py already defaults to these
# values — so with the standard Docker setup you don't need a .env at all.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=full_text_search_demo
DB_USER=postgres
DB_PASSWORD=postgres
